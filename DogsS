local function GetRoundTimeLeft()
    local roundFolder = ReplicatedStorage:FindFirstChild("Round")
    if not roundFolder then return math.huge end
    local endsAt = roundFolder:GetAttribute("EndsAt") or 0
    if endsAt <= 0 then return math.huge end
    return math.max(0, endsAt - workspace:GetServerTimeNow())
end

local function IsInRound()
    local stats = LocalPlayer:FindFirstChild("RoundStats")
    if not stats or stats:GetAttribute("InRound") ~= true then
        return false
    end

    local char = LocalPlayer.Character
    if not char or char:GetAttribute("LobbyIntro") == true then
        return false
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root or IsPointInLobby(root.Position) then
        return false
    end

    local map = workspace:FindFirstChild("CurrentMap")
    if not map or #map:GetChildren() == 0 then
        return false
    end

    return true
end

