local function UpdateRayFilter()
    local filter = {}
    local map = workspace:FindFirstChild("CurrentMap")
    local planks = workspace:FindFirstChild("Planks")
    if map then table.insert(filter, map) end
    if planks then table.insert(filter, planks) end
    MapRayParams.FilterDescendantsInstances = filter

    local losFilter = {}
    if map then table.insert(losFilter, map) end
    local lobby = workspace:FindFirstChild("Lobby")
    if lobby then table.insert(losFilter, lobby) end
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then table.insert(losFilter, npcs) end
    GunLosParams.FilterDescendantsInstances = losFilter
end

local CachedLobbyBox = nil
local function IsPointInLobby(pos)
    local lobby = workspace:FindFirstChild("Lobby")
    if not lobby then return false end

    if not CachedLobbyBox then
        local minV, maxV = nil, nil
        for _, d in ipairs(lobby:GetDescendants()) do
            if d:IsA("BasePart") then
                local half = d.Size * 0.5
                local pMin = d.Position - half
                local pMax = d.Position + half
                minV = minV and minV:Min(pMin) or pMin
                maxV = maxV and maxV:Max(pMax) or pMax
            end
        end
        if minV and maxV then
            local pad = Vector3.new(25, 25, 25)
            CachedLobbyBox = { Min = minV - pad, Max = maxV + pad }
        end
    end

    if CachedLobbyBox then
        local bMin, bMax = CachedLobbyBox.Min, CachedLobbyBox.Max
        return pos.X >= bMin.X and pos.X <= bMax.X
            and pos.Y >= bMin.Y and pos.Y <= bMax.Y
            and pos.Z >= bMin.Z and pos.Z <= bMax.Z
    end
    return false
end

