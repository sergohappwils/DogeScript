local UILoop = task.spawn(function()
    while Hub.Running do
        local mapRemaining = #GetUncollectedBonbons()
        local shopBal = GetShopBonbons()
        local stam = math.floor(GetLiveStamina() + 0.5)
        local sprintState = Hub.InfStamina and "inf" or (Hub.RestingStamina and "regen" or (Hub.WeSetSprint and "run" or "walk"))

        StatusLabel.Text = string.format(
            "bonbons: %d (+%d) | left: %d | stam: %d (%s)\n%s | %s",
            shopBal, Hub.CollectedCount, mapRemaining, stam, sprintState, Hub.StatusText, Hub.GunStatusText
        )
        task.wait(0.2)
    end
end)

table.insert(Hub.Connections, UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.RightControl then
        ScreenGui.Enabled = not ScreenGui.Enabled
    end
end))

function Hub:Unload()
    Hub.Running = false
    Hub.AutoWalkEnabled = false
    Hub.AuraEnabled = false
    Hub.AutoAimGuns = false
    Hub.AutoGun = false
    Hub.DogHitboxEnabled = false
    Hub.MoveGoal = nil
    ReleaseMinigunSpin()
    RestoreAllDogHitboxes()
    pcall(function()
        RunService:UnbindFromRenderStep(BIND_STEP_NAME)
    end)
    if ClientGunfire and ClientGunfire._OrigScatter then
        ClientGunfire._scatter = ClientGunfire._OrigScatter
    end
    if ClientGunfire and ClientGunfire._OrigPredict then
        ClientGunfire.Predict = ClientGunfire._OrigPredict
    end
    if ClientGun and ClientGun._OrigFire then
        ClientGun._fire = ClientGun._OrigFire
    end
    pcall(ApplySprintState, false)
    for _, conn in ipairs(Hub.Connections) do
        pcall(function()
            if conn and conn.Connected then
                conn:Disconnect()
            end
        end)
    end
    table.clear(Hub.Connections)
    pcall(task.cancel, WalkerThread)
    pcall(task.cancel, UILoop)
    table.clear(Hub.ESPMap)
    table.clear(Hub.DogESPMap)
    pcall(game.Destroy, ESPContainer)
    pcall(game.Destroy, ScreenGui)
    getgenv()._DogsBonbonCollector = nil
end

table.insert(Hub.Connections, CloseBtn.Activated:Connect(function()
    task.spawn(function()
        Hub:Unload()
    end)
end))
