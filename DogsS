    end)

    local oldNames = {
        DogsBonbonESP = true,
        BonbonESPFolder = true,
        DogsBonbonUI = true,
        BonbonZeroTpHub = true,
        BonbonDiagHub = true,
        BonbonDiagV2UI = true,
        BonbonSafeDiagUI = true,
        BonbonDiagBeaconHL = true,
