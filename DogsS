local function MakeToggle(parent, order, text, prop, pos, size)
    local btn = Instance.new("TextButton")
    btn.LayoutOrder = order
    if pos then btn.Position = pos end
    if size then btn.Size = size end
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextColor3 = Color3.fromRGB(240, 240, 245)
    btn.AutoButtonColor = false
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 5)
    c.Parent = btn

    local function Refresh()
        local on = Hub[prop]
        btn.Text = text .. ": " .. (on and "ON" or "OFF")
        btn.BackgroundColor3 = on and Color3.fromRGB(45, 90, 58) or Color3.fromRGB(32, 32, 40)
    end

    ToggleRefreshers[prop] = ToggleRefreshers[prop] or {}
    table.insert(ToggleRefreshers[prop], Refresh)

    table.insert(Hub.Connections, btn.Activated:Connect(function()
        Hub[prop] = not Hub[prop]
        for _, fn in ipairs(ToggleRefreshers[prop]) do
            fn()
        end
    end))

    Refresh()
    return btn
end

