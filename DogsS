local function FormatGunsInventorySummary(guns)
    local parts = {}
    for i = 1, math.min(#guns, 3) do
        local g = guns[i]
        local l, r, rel = GetGunAmmoState(g)
        local shortName = g.Name
        if shortName == "DoubleBarrel" then shortName = "DB"
        elseif shortName == "HuntingRifle" then shortName = "HR"
        elseif shortName == "HallowsLauncher" then shortName = "HL"
        end
        if rel then
            table.insert(parts, string.format("%s[rel/%d]", shortName, r))
        else
            table.insert(parts, string.format("%s[%d/%d]", shortName, l, r))
        end
    end
    return table.concat(parts, " ")
end

local LastReloadFire = 0
local LastGunFire = 0

local function StepGunCombat(charData, inRound)
    if not inRound then
        Hub.LockedDog = nil
        Hub.WeEquippedGun = false
        ReleaseMinigunSpin()
        Hub.GunStatusText = Hub.AutoAimGuns and "guns: auto-aim ready" or "guns: lobby"
        return
    end

    if not charData or charData.Disabled then
        ReleaseMinigunSpin()
        Hub.GunStatusText = "guns: waiting..."
        return
    end

    local guns = GetAllPlayerGuns(charData.Character)
    if #guns == 0 then
        Hub.LockedDog = nil
        Hub.WeEquippedGun = false
        ReleaseMinigunSpin()
        Hub.GunStatusText = "guns: none in inventory"
        return
    end

    local equippedGun = nil
    local reloadingGun = nil
    local anyGunHasAmmo = false

    for _, g in ipairs(guns) do
        if Hub.AutoAimGuns then
            if g:GetAttribute("Spread") ~= 0 then
                pcall(function() g:SetAttribute("Spread", 0) end)
            end
        else
            local spec = GetGunSpec(g)
            if spec and type(spec.Spread) == "number" and g:GetAttribute("Spread") == 0 and spec.Spread > 0 then
                pcall(function() g:SetAttribute("Spread", spec.Spread) end)
            end
        end
        if g.Parent == charData.Character then
            equippedGun = g
        end
        local l, r, rel = GetGunAmmoState(g)
        if rel and not reloadingGun then
            reloadingGun = g
        end
        if l > 0 or r > 0 or rel then
            anyGunHasAmmo = true
        end
    end

    if not Hub.AutoGun then
        Hub.WeEquippedGun = false
        ReleaseMinigunSpin()
        local modeStr = Hub.AutoAimGuns and "aim:ON" or "aim:OFF"
        local hbStr = Hub.DogHitboxEnabled and string.format("hb:%d", Hub.DogHitboxSize) or "hb:OFF"
        Hub.GunStatusText = string.format("%s %s | %s", modeStr, hbStr, FormatGunsInventorySummary(guns))
        return
    end

    if not anyGunHasAmmo then
        Hub.LockedDog = nil
        ReleaseMinigunSpin()
        if equippedGun then
            pcall(function() charData.Humanoid:UnequipTools() end)
        end
        Hub.WeEquippedGun = false
        Hub.GunStatusText = string.format("guns (%d): all empty (unequipped)", #guns)
        return
    end

    if reloadingGun then
        ReleaseMinigunSpin()
        if equippedGun ~= reloadingGun then
            Hub.WeEquippedGun = true
            pcall(function() charData.Humanoid:EquipTool(reloadingGun) end)
        end
        local _, res = GetGunAmmoState(reloadingGun)
        Hub.GunStatusText = string.format("%s: reloading (res %d)", reloadingGun.Name, res)
        return
    end

    if equippedGun then
        local el, er, erel = GetGunAmmoState(equippedGun)
        if el <= 0 and er <= 0 and not erel then
            ReleaseMinigunSpin()
            pcall(function() charData.Humanoid:UnequipTools() end)
            equippedGun = nil
            Hub.WeEquippedGun = false
        end
    end

    local hpPct = (charData.Humanoid.Health / math.max(charData.Humanoid.MaxHealth, 1)) * 100
    local roundStatus = GetRoundStatus()
    local timeLeft = (roundStatus == "Round") and GetRoundTimeLeft() or math.huge

    local lowHpTriggered = hpPct <= Hub.GunTriggerHP
    local timerTriggered = (roundStatus == "Round") and (timeLeft <= Hub.GunTriggerTime)

    if not lowHpTriggered and not timerTriggered then
        Hub.LockedDog = nil
        ReleaseMinigunSpin()
        if equippedGun and Hub.WeEquippedGun then
            Hub.WeEquippedGun = false
            pcall(function() charData.Humanoid:UnequipTools() end)
        end
        Hub.GunStatusText = string.format(
            "%s | wait (<=%d%% or <=%ds)",
            FormatGunsInventorySummary(guns),
            Hub.GunTriggerHP,
            Hub.GunTriggerTime
        )
        return
    end

    local activeGun = nil

    if equippedGun then
        local el = GetGunAmmoState(equippedGun)
        if el > 0 then
            activeGun = equippedGun
        end
    end

    if not activeGun then
        for _, g in ipairs(guns) do
            local l = GetGunAmmoState(g)
            if l > 0 then
                activeGun = g
                break
            end
        end
    end

    if not activeGun and equippedGun then
        local _, er = GetGunAmmoState(equippedGun)
        if er > 0 then
            activeGun = equippedGun
        end
    end

    if not activeGun then
        for _, g in ipairs(guns) do
            local _, r = GetGunAmmoState(g)
            if r > 0 then
                activeGun = g
                break
            end
        end
    end

    if not activeGun then
        ReleaseMinigunSpin()
        return
    end

    local isEquipped = (activeGun.Parent == charData.Character)
    local loaded, reserve = GetGunAmmoState(activeGun)

    if loaded <= 0 and reserve > 0 then
        ReleaseMinigunSpin()
        if not isEquipped then
            Hub.WeEquippedGun = true
            pcall(function() charData.Humanoid:EquipTool(activeGun) end)
            Hub.GunStatusText = string.format("%s: equipping to reload...", activeGun.Name)
            return
        end
        if os.clock() - LastReloadFire > 0.4 then
            LastReloadFire = os.clock()
            local relRem = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("RifleReload")
            if relRem and relRem:IsA("RemoteEvent") then
                relRem:FireServer()
            end
        end
        Hub.GunStatusText = string.format("%s: reload -> res %d", activeGun.Name, reserve)
        return
    end

    local originPos = GetGunOriginPos(activeGun, charData)
    local gunRange = GetGunRange(activeGun)
    local dogModel, aimPart = SelectTargetDogToShoot(originPos, gunRange)

    if not dogModel or not aimPart then
        ReleaseMinigunSpin()
        if isEquipped and Hub.WeEquippedGun then
            Hub.WeEquippedGun = false
            pcall(function() charData.Humanoid:UnequipTools() end)
        end
        Hub.GunStatusText = string.format("%s [%d/%d] active (no LOS)", activeGun.Name, loaded, reserve)
        return
    end

    if not isEquipped then
        ReleaseMinigunSpin()
        Hub.WeEquippedGun = true
        pcall(function() charData.Humanoid:EquipTool(activeGun) end)
        Hub.GunStatusText = string.format("equipping %s...", activeGun.Name)
        return
    end

    local spec = GetGunSpec(activeGun)
    if spec and spec.WindUp and ClientMinigun then
        Hub.MinigunHeldTool = activeGun
        pcall(function()
            ClientMinigun:Hold(activeGun, "trigger", true)
        end)
        local okReady, isReady = pcall(ClientMinigun.Ready, ClientMinigun, activeGun)
        if okReady and not isReady then
            Hub.GunStatusText = string.format("%s [%d/%d] spinning up...", activeGun.Name, loaded, reserve)
            return
        end
    else
        ReleaseMinigunSpin()
    end

    local cooldown = GetGunFireCooldown(activeGun)
    if os.clock() - LastGunFire >= math.max(cooldown * 0.9, 0.05) then
        LastGunFire = os.clock()
        local aimPos = ComputePredictedAimPos(activeGun, originPos, aimPart)

        if ClientGun and type(ClientGun._OrigFire or ClientGun._fire) == "function" then
            if ClientGun._tool ~= activeGun then
                local equipSpec = spec or { Auto = true, Range = gunRange, FireCooldown = cooldown }
                pcall(ClientGun._equip, ClientGun, activeGun, equipSpec)
            end
            pcall(ClientGun._OrigFire or ClientGun._fire, ClientGun, activeGun, aimPos)
        elseif ClientGunfire then
            local handle = activeGun:FindFirstChild("Handle")
            local muzzle = handle and handle:FindFirstChild("Muzzle")
            local mPos = (muzzle and muzzle:IsA("Attachment") and muzzle.WorldPosition) or originPos
            local dir = (aimPos - mPos)
            if dir.Magnitude > 0.1 then
                local hits, insts = ClientGunfire:Fire(activeGun, mPos, dir.Unit)
                if hits then
                    local fireRem = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("RifleFire")
                    if fireRem and fireRem:IsA("RemoteEvent") then
                        fireRem:FireServer(hits, insts)
                    end
                end
            end
        end
    end

    local dogHum = dogModel:FindFirstChildOfClass("Humanoid")
    local dogHp = dogHum and math.ceil(dogHum.Health) or 0
    Hub.GunStatusText = string.format("%s [%d/%d] -> %s (%dhp)", activeGun.Name, loaded, reserve, dogModel.Name, dogHp)
end

