local function GetCharacterData()
    local char = LocalPlayer.Character
    if not char or not char.Parent then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root or not root.Parent then return nil end

    local disabled = (char:GetAttribute("Ragdolled") == true)
        or (char:GetAttribute("Dragged") == true)
        or (char:GetAttribute("LobbyIntro") == true)

    return {
        Character = char,
        Humanoid = hum,
        Root = root,
        Torso = char:FindFirstChild("Torso"),
        Head = char:FindFirstChild("Head"),
        Disabled = disabled
    }
end

local function ApplySprintState(wantSprint)
    if not ClientSprint then return end
    if wantSprint then
        Hub.WeSetSprint = true
        if not rawget(ClientSprint, "_held") then
            pcall(ClientSprint._toggle, ClientSprint, true)
            rawset(ClientSprint, "_held", true)
        end
    else
        if Hub.WeSetSprint then
            Hub.WeSetSprint = false
            if rawget(ClientSprint, "_held") then
                pcall(ClientSprint._toggle, ClientSprint, false)
                rawset(ClientSprint, "_held", false)
            end
        end
    end
end

local COLOR_FULL_HP = Color3.fromRGB(65, 255, 95)
local COLOR_HALF_HP = Color3.fromRGB(255, 210, 50)
local COLOR_LOW_HP  = Color3.fromRGB(255, 45, 45)
local COLOR_ALLY    = Color3.fromRGB(70, 210, 255)
local COLOR_STATIC  = Color3.fromRGB(255, 75, 75)

local function GetDogHealthColor(hpRatio, isZombie)
    if isZombie then
        return COLOR_ALLY
    end
    if not Hub.DogESPHealthColor then
        return COLOR_STATIC
    end
    hpRatio = math.clamp(hpRatio, 0, 1)
    if hpRatio >= 0.5 then
        return COLOR_HALF_HP:Lerp(COLOR_FULL_HP, (hpRatio - 0.5) / 0.5)
    else
        return COLOR_LOW_HP:Lerp(COLOR_HALF_HP, hpRatio / 0.5)
    end
end

local function RestoreDogHitbox(dogModel)
    local data = Hub.DogHitboxData[dogModel]
    if not data then return end
    if data.HitboxPart and data.HitboxPart.Parent then
        pcall(game.Destroy, data.HitboxPart)
    end
    if data.RootPart and data.RootPart.Parent and data.OrigRootSize then
        pcall(function()
            data.RootPart.Size = data.OrigRootSize
            data.RootPart.CanCollide = data.OrigRootCollide
        end)
    end
    Hub.DogHitboxData[dogModel] = nil
end

local function RestoreAllDogHitboxes()
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then
        for _, npc in ipairs(npcs:GetChildren()) do
            local hb = npc:FindFirstChild("DogHitbox")
            if hb then pcall(game.Destroy, hb) end
        end
    end
    for dogModel in pairs(Hub.DogHitboxData) do
        RestoreDogHitbox(dogModel)
    end
end

local function UpdateDogHitboxes()
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs or not Hub.DogHitboxEnabled then
        if next(Hub.DogHitboxData) ~= nil then
            RestoreAllDogHitboxes()
        end
        return
    end

    local sz = math.clamp(tonumber(Hub.DogHitboxSize) or 16, 2, MAX_DOG_HITBOX)
    local activeModels = {}

    for _, npc in ipairs(npcs:GetChildren()) do
        if npc:IsA("Model") then
            local hum = npc:FindFirstChildOfClass("Humanoid")
            local torso = npc:FindFirstChild("Torso")
            local hrp = npc:FindFirstChild("HumanoidRootPart")
            local isEnemyAlive = hum and hum.Health > 0 and npc:GetAttribute("Zombie") ~= true and (torso or hrp)

            if isEnemyAlive then
                activeModels[npc] = true
                local data = Hub.DogHitboxData[npc]
                if not data then
                    data = {
                        RootPart = hrp,
                        OrigRootSize = hrp and hrp.Size or nil,
                        OrigRootCollide = hrp and hrp.CanCollide or false
                    }
                    Hub.DogHitboxData[npc] = data
                end

                local targetPart = torso or hrp
                local hb = data.HitboxPart or npc:FindFirstChild("DogHitbox")
                if not hb or not hb.Parent then
                    hb = Instance.new("Part")
                    hb.Name = "DogHitbox"
                    hb.Shape = Enum.PartType.Block
                    hb.Material = Enum.Material.SmoothPlastic
                    hb.Anchored = false
                    hb.CanCollide = false
                    hb.CanTouch = false
                    hb.CanQuery = true
                    hb.Massless = true
                    hb.CastShadow = false
                    hb.CFrame = targetPart.CFrame
                    hb.Parent = npc

                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = targetPart
                    weld.Part1 = hb
                    weld.Parent = hb

                    data.HitboxPart = hb
                end

                local hpRatio = hum.Health / math.max(hum.MaxHealth, 1)
                local col = GetDogHealthColor(hpRatio, false)

                hb.Size = Vector3.new(sz, sz, sz)
                hb.Color = col
                hb.Transparency = Hub.DogHitboxVisible and 0.82 or 1

                if hrp and data.OrigRootSize then
                    hrp.Size = Vector3.new(sz, data.OrigRootSize.Y, sz)
                    hrp.CanCollide = false
                end
            else
                if Hub.DogHitboxData[npc] then
                    RestoreDogHitbox(npc)
                end
            end
        end
    end

    for dogModel in pairs(Hub.DogHitboxData) do
        if not activeModels[dogModel] or not dogModel.Parent then
            RestoreDogHitbox(dogModel)
        end
    end
end

local function GetGunSpec(tool)
    if not tool then return nil end
    local cached = GunSpecCache[tool]
    if cached ~= nil then
        return cached or nil
    end
    local cfg = tool:FindFirstChild("GunConfig")
    if cfg and cfg:IsA("ModuleScript") then
        local ok, res = pcall(require, cfg)
        if ok and type(res) == "table" then
            GunSpecCache[tool] = res
            return res
        end
    end
    GunSpecCache[tool] = false
    return nil
end

local function IsGunTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    if tool:FindFirstChild("GunConfig") then return true end
    local shopTool = tool:GetAttribute("ShopTool")
    if type(shopTool) == "string" and KnownGunNames[shopTool] then return true end
    if KnownGunNames[tool.Name] then return true end
    if tool:GetAttribute("Loaded") ~= nil and tool:GetAttribute("FireCooldown") ~= nil then return true end
    return false
end

local function GetAllPlayerGuns(char)
    char = char or LocalPlayer.Character
    local guns = {}
    local seen = {}

    if char then
        for _, c in ipairs(char:GetChildren()) do
            if IsGunTool(c) and not seen[c] then
                seen[c] = true
                table.insert(guns, c)
            end
        end
    end

    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, c in ipairs(bp:GetChildren()) do
            if IsGunTool(c) and not seen[c] then
                seen[c] = true
                table.insert(guns, c)
            end
        end
    end

    table.sort(guns, function(a, b)
        local aKey = a:GetAttribute("ShopTool") or a.Name
        local bKey = b:GetAttribute("ShopTool") or b.Name
        local aRank = GunPriorityRank[aKey] or 50
        local bRank = GunPriorityRank[bKey] or 50
        if aRank ~= bRank then
            return aRank < bRank
        end
        return a.Name < b.Name
    end)

    return guns
end

local function GetGunAmmoState(tool)
    if not tool then return 0, 0, false end
    local loaded = tool:GetAttribute("Loaded") or 0
    if ClientGunfire and type(ClientGunfire.Ammo) == "function" and tool.Parent == LocalPlayer.Character then
        local ok, predAmmo = pcall(ClientGunfire.Ammo, ClientGunfire, tool)
        if ok and type(predAmmo) == "number" then
            loaded = predAmmo
        end
    end
    local reserve = tool:GetAttribute("Reserve") or 0
    local reloading = tool:GetAttribute("Reloading") == true
    return loaded, reserve, reloading
end

local function GetGunRange(tool)
    if not tool then return 280 end
    local attrRange = tool:GetAttribute("Range")
    if type(attrRange) == "number" and attrRange > 0 then
        return attrRange
    end
    local spec = GetGunSpec(tool)
    if spec and type(spec.Range) == "number" and spec.Range > 0 then
        return spec.Range
    end
    return 280
end

local function GetGunFireCooldown(tool)
    if not tool then return 0.1 end
    local attrCd = tool:GetAttribute("FireCooldown")
    if type(attrCd) == "number" and attrCd > 0 then
        return attrCd
    end
    local spec = GetGunSpec(tool)
    if spec and type(spec.FireCooldown) == "number" and spec.FireCooldown > 0 then
        return spec.FireCooldown
    end
    return 0.1
end

local function GetGunOriginPos(tool, charData)
    local handle = tool and tool:FindFirstChild("Handle")
    local muzzle = handle and handle:FindFirstChild("Muzzle")
    if tool and charData and tool.Parent == charData.Character and muzzle and muzzle:IsA("Attachment") then
        return muzzle.WorldPosition
    end
    if charData and charData.Head then
        return charData.Head.Position
    end
    if charData and charData.Root then
        return charData.Root.Position
    end
    local cam = workspace.CurrentCamera
    return cam and cam.CFrame.Position or Vector3.zero
end

local function ComputePredictedAimPos(tool, originPos, aimPart)
    if not aimPart then return originPos end
    local vel = aimPart.AssemblyLinearVelocity
    local spec = GetGunSpec(tool)
    if spec and type(spec.Rocket) == "table" then
        local rocketSpeed = tonumber(spec.Rocket.Speed) or 140
        local dist = (aimPart.Position - originPos).Magnitude
        local t = math.clamp(dist / math.max(rocketSpeed, 1), 0, 1.0)
        return aimPart.Position + Vector3.new(vel.X, 0, vel.Z) * t
    end
    return aimPart.Position + Vector3.new(vel.X, vel.Y * 0.2, vel.Z) * 0.03
end

local function HasGunLineOfSight(originPos, dogModel)
    UpdateRayFilter()
    for _, partName in ipairs({ "Torso", "Head", "HumanoidRootPart" }) do
        local part = dogModel:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local delta = part.Position - originPos
            local dist = delta.Magnitude
            if dist >= 0.2 then
                local dir = delta.Unit
                local curOrigin = originPos
                local remaining = dist
                local clear = false

                for _ = 1, 6 do
                    local hit = workspace:Raycast(curOrigin, dir * remaining, GunLosParams)
                    if not hit then
                        clear = true
                        break
                    end
                    local hitInst = hit.Instance
                    if hitInst:IsDescendantOf(dogModel) then
                        clear = true
                        break
                    end
                    local hitModel = hitInst:FindFirstAncestorOfClass("Model")
                    local isOtherNpc = hitModel and hitModel:FindFirstChildOfClass("Humanoid") ~= nil
                    if (not hitInst:IsA("Terrain") and hitInst.Transparency >= 1 and not isOtherNpc) or (isOtherNpc and hitModel:GetAttribute("Zombie") ~= true) then
                        local step = hit.Distance + 0.05
                        curOrigin = curOrigin + dir * step
                        remaining = remaining - step
                        if remaining <= 0.1 then
                            clear = true
                            break
                        end
                    else
                        break
                    end
                end

                if clear then
                    return part
                end
            else
                return part
            end
        end
    end
    return nil
end

local function IsDogAliveAndValid(dogModel)
    if not dogModel or not dogModel.Parent then return false end
    local hum = dogModel:FindFirstChildOfClass("Humanoid")
    local root = dogModel:FindFirstChild("Torso") or dogModel:FindFirstChild("HumanoidRootPart")
    return hum ~= nil
        and hum.Health > 0
        and root ~= nil
        and dogModel:GetAttribute("Zombie") ~= true
end

local function SelectTargetDogToShoot(originPos, maxRange)
    maxRange = maxRange or 280
    if IsDogAliveAndValid(Hub.LockedDog) then
        local r = Hub.LockedDog:FindFirstChild("Torso") or Hub.LockedDog:FindFirstChild("HumanoidRootPart")
        if r and (r.Position - originPos).Magnitude <= maxRange then
            local aimPart = HasGunLineOfSight(originPos, Hub.LockedDog)
            if aimPart then
                return Hub.LockedDog, aimPart
            end
        end
    end

    Hub.LockedDog = nil
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return nil, nil end

    local candidates = {}
    for _, npc in ipairs(npcs:GetChildren()) do
        if IsDogAliveAndValid(npc) then
            local r = npc:FindFirstChild("Torso") or npc:FindFirstChild("HumanoidRootPart")
            local d = r and (r.Position - originPos).Magnitude or math.huge
            if d <= maxRange then
                table.insert(candidates, { Model = npc, Dist = d })
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.Dist < b.Dist
    end)

    for _, cand in ipairs(candidates) do
        local aimPart = HasGunLineOfSight(originPos, cand.Model)
        if aimPart then
            Hub.LockedDog = cand.Model
            return cand.Model, aimPart
        end
    end

    return nil, nil
end

