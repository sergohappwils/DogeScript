local function TriggerTouch(part, charData)
    if TouchingParts[part] then return end
    TouchingParts[part] = true

    task.spawn(function()
        if part and part.Parent and charData.Root and charData.Root.Parent then
            pcall(firetouchinterest, charData.Root, part, 0)
            pcall(firetouchinterest, part, charData.Root, 0)
            if charData.Torso then
                pcall(firetouchinterest, charData.Torso, part, 0)
                pcall(firetouchinterest, part, charData.Torso, 0)
            end
            if charData.Head then
                pcall(firetouchinterest, charData.Head, part, 0)
                pcall(firetouchinterest, part, charData.Head, 0)
            end

            task.wait(0.05)

            if part and part.Parent and charData.Root and charData.Root.Parent then
                pcall(firetouchinterest, charData.Root, part, 1)
                pcall(firetouchinterest, part, charData.Root, 1)
                if charData.Torso then
                    pcall(firetouchinterest, charData.Torso, part, 1)
                    pcall(firetouchinterest, part, charData.Torso, 1)
                end
                if charData.Head then
                    pcall(firetouchinterest, charData.Head, part, 1)
                    pcall(firetouchinterest, part, charData.Head, 1)
                end
            end
        end
        task.wait(0.03)
        TouchingParts[part] = nil
    end)
end

