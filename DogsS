local function PointToSegmentDistance(pt, a, b)
    local ab = b - a
    local lenSq = ab:Dot(ab)
    if lenSq < 0.001 then
        return (pt - a).Magnitude
    end
    local t = math.clamp((pt - a):Dot(ab) / lenSq, 0, 1)
    local proj = a + ab * t
    return (pt - proj).Magnitude
end

local function GetThreatMetrics(pos, threats)
    threats = threats or GetActiveThreats()
    local minDist = math.huge
    local nearestThreat = nil
    for _, t in ipairs(threats) do
        local d1 = (t.Pos - pos).Magnitude
        local d2 = (t.PredPos - pos).Magnitude
        local d = math.min(d1, d2)
        if d < minDist then
            minDist = d
            nearestThreat = t
        end
    end
    return minDist, nearestThreat
end

local function GetNearestDogSpawnDist(pos, dogSpawns)
    dogSpawns = dogSpawns or GetDogSpawnPositions()
    local minDist = math.huge
    local nearestPos = nil
    for _, sp in ipairs(dogSpawns) do
        local d = (sp - pos).Magnitude
        if d < minDist then
            minDist = d
            nearestPos = sp
        end
    end
    return minDist, nearestPos
end

local function GetCorridorThreatDist(myPos, targetPos, threats)
    local minCorridorDist = math.huge
    for _, t in ipairs(threats) do
        local d1 = PointToSegmentDistance(t.Pos, myPos, targetPos)
        local d2 = PointToSegmentDistance(t.PredPos, myPos, targetPos)
        local d = math.min(d1, d2)
        if d < minCorridorDist then
            minCorridorDist = d
        end
    end
    return minCorridorDist
end

local function CanRushBonbon(myPos, bPos, threats)
    local dist = (bPos - myPos).Magnitude
    local yDiff = math.abs(bPos.Y - myPos.Y)
    if yDiff > 9.5 or dist > Hub.CandyRushRadius then
        return false
    end
    local grabTravelDist = math.max(dist - (Hub.AuraRadius - 1.5), 0)
    if grabTravelDist <= 7.5 then
        return true
    end
    local dogDistAtCandy = GetThreatMetrics(bPos, threats)
    local corridorDist = GetCorridorThreatDist(myPos, bPos, threats)
    if grabTravelDist < dogDistAtCandy * 0.9 and corridorDist >= 5.5 then
        return true
    end
    return false
end

local function GetStuckAndHazardPenalty(pos, dogSpawns, ragdollPads)
    local now = os.clock()
    local penalty = 0
    for i = #Hub.StuckZones, 1, -1 do
        local z = Hub.StuckZones[i]
        if now >= z.Expire then
            table.remove(Hub.StuckZones, i)
        else
            local flatDist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(z.Pos.X, 0, z.Pos.Z)).Magnitude
            local yDist = math.abs(pos.Y - z.Pos.Y)
            if flatDist < z.Radius and yDist < 8 then
                penalty += (z.Radius - flatDist) * 34
            end
        end
    end

    if ragdollPads then
        for _, pad in ipairs(ragdollPads) do
            local d = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(pad.Pos.X, 0, pad.Pos.Z)).Magnitude
            if d < pad.Radius and math.abs(pos.Y - pad.Pos.Y) < 8 then
                penalty += (pad.Radius - d) * 60
            end
        end
    end

    if Hub.AvoidDogs and dogSpawns then
        local status = GetRoundStatus()
        local weight = (status == "Headstart") and 3.5 or 0.8
        for _, sp in ipairs(dogSpawns) do
            local d = (pos - sp).Magnitude
            if d < Hub.DogSpawnAvoidRadius then
                penalty += (Hub.DogSpawnAvoidRadius - d) * weight
            end
        end
    end

    return penalty
end

local function ChooseTargetBonbon(myPos, threats, dogSpawns)
    local bonbons = GetUncollectedBonbons()
    if #bonbons == 0 then return nil end

    local now = os.clock()
    local candidates = {}
    for _, part in ipairs(bonbons) do
        local expire = Hub.Blacklist[part]
        if not expire or now >= expire then
            table.insert(candidates, part)
        end
    end

    if #candidates == 0 then
        table.clear(Hub.Blacklist)
        candidates = bonbons
    end

    local status = GetRoundStatus()
    local bestPart = nil
    local bestScore = math.huge

    for _, part in ipairs(candidates) do
        local bPos = GetTrueBonbonPos(part)
        local dist = (bPos - myPos).Magnitude
        local yDiff = math.abs(bPos.Y - myPos.Y)
        local dogDistAtCandy = GetThreatMetrics(bPos, threats)
        local corridorDist = GetCorridorThreatDist(myPos, bPos, threats)
        local spawnDistAtCandy = GetNearestDogSpawnDist(bPos, dogSpawns)

        local canQuickGrab = CanRushBonbon(myPos, bPos, threats)
        local pathIsSafe = (not Hub.AvoidDogs)
            or (dogDistAtCandy >= Hub.DogDangerRadius and corridorDist >= Hub.DogPathCorridor)
            or canQuickGrab

        if pathIsSafe then
            local penalty = 0
            if Hub.AvoidDogs then
                if dogDistAtCandy < Hub.DogDangerRadius then
                    penalty += (Hub.DogDangerRadius - dogDistAtCandy) * 4.5
                end
                if corridorDist < Hub.DogPathCorridor then
                    penalty += (Hub.DogPathCorridor - corridorDist) * 5.5
                end
                if status == "Headstart" and spawnDistAtCandy < Hub.DogSpawnAvoidRadius then
                    penalty += (Hub.DogSpawnAvoidRadius - spawnDistAtCandy) * 2.5
                end
            end

            local score = dist + (yDiff * 1.4) + penalty
            if canQuickGrab then
                score = score * 0.45
            end

            if score < bestScore then
                bestScore = score
                bestPart = part
            end
        end
    end

    if not bestPart then
        for _, part in ipairs(candidates) do
            local bPos = GetTrueBonbonPos(part)
            local dist = (bPos - myPos).Magnitude
            local dogDistAtCandy = GetThreatMetrics(bPos, threats)
            local score = dist + math.max(0, 22 - dogDistAtCandy) * 5
            if score < bestScore then
                bestScore = score
                bestPart = part
            end
        end
    end

    return bestPart
end

local TouchingParts = setmetatable({}, { __mode = "k" })
