    table.insert(Hub.Connections, shop:GetAttributeChangedSignal("Bonbons"):Connect(function()
        local cur = shop:GetAttribute("Bonbons") or 0
        if cur > lastBal then
            Hub.CollectedCount += (cur - lastBal)
        end
        lastBal = cur
    end))
end
