    for dogModel in pairs(Hub.DogESPMap) do
        if not validDogs[dogModel] or not dogModel.Parent then
            ClearDogESPForModel(dogModel)
        end
    end
end

local LastJumpTick = 0
local function TriggerSmartJump(charData)
    if not charData or not charData.Humanoid then return false end
    if os.clock() - LastJumpTick < 0.28 then return false end
    if charData.Humanoid.FloorMaterial == Enum.Material.Air then return false end

    local stam = GetLiveStamina()
    if not Hub.InfStamina and stam < 10 then
        return false
    end

    LastJumpTick = os.clock()
    local hum = charData.Humanoid
    local prevRest = ClientSprint and rawget(ClientSprint, "_restingSince")
    hum.Jump = true
    pcall(hum.ChangeState, hum, Enum.HumanoidStateType.Jumping)

    if Hub.RestingStamina and ClientSprint and prevRest then
        task.defer(function()
            if ClientSprint and Hub.RestingStamina then
                rawset(ClientSprint, "_restingSince", prevRest)
            end
        end)
    end
    return true
end

