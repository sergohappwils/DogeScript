local function LocateLiveControllers()
    pcall(function()
        local cl = ReplicatedStorage:FindFirstChild("Client")
        if cl then
            if not ClientSprint and cl:FindFirstChild("Sprint") then
                ClientSprint = require(cl.Sprint)
            end
            if not ClientBonbons and cl:FindFirstChild("Bonbons") then
                ClientBonbons = require(cl.Bonbons)
            end
            if not ClientSkillCheck and cl:FindFirstChild("SkillCheck") then
                ClientSkillCheck = require(cl.SkillCheck)
            end
            if not ClientGun and cl:FindFirstChild("GunClient") then
                ClientGun = require(cl.GunClient)
            end
            if not ClientGunfire and cl:FindFirstChild("Gunfire") then
                ClientGunfire = require(cl.Gunfire)
            end
            if not ClientMinigun and cl:FindFirstChild("Minigun") then
                ClientMinigun = require(cl.Minigun)
            end
        end
    end)

    if (not ClientSprint or not ClientBonbons or not ClientSkillCheck) and type(getgc) == "function" then
        local ok, gc = pcall(getgc, true)
        if ok and type(gc) == "table" then
            for _, v in ipairs(gc) do
                if type(v) == "table" then
                    if not ClientSprint and rawget(v, "_stamina") ~= nil and type(rawget(v, "_step")) == "function" then
                        ClientSprint = v
                    elseif not ClientBonbons and type(rawget(v, "_spinning")) == "table" then
                        ClientBonbons = v
                    elseif not ClientSkillCheck and rawget(v, "_gui") ~= nil and rawget(v, "_pointer") ~= nil and rawget(v, "_zone") ~= nil then
                        ClientSkillCheck = v
                    end
                end
            end
        end
    end

    if ClientGunfire and type(rawget(ClientGunfire, "_scatter")) == "function" then
        ClientGunfire._OrigScatter = ClientGunfire._OrigScatter or ClientGunfire._scatter
        ClientGunfire._scatter = function(self, dir, spread)
            if Hub.Running and Hub.AutoAimGuns then
                return dir
            end
            return ClientGunfire._OrigScatter(self, dir, spread)
        end
    end

    if ClientGunfire and type(rawget(ClientGunfire, "_cast")) == "function" and ClientGunfire._OrigCast then
        ClientGunfire._cast = ClientGunfire._OrigCast
        ClientGunfire._OrigCast = nil
    end

    if ClientGunfire and type(rawget(ClientGunfire, "Predict")) == "function" then
        ClientGunfire._OrigPredict = ClientGunfire._OrigPredict or ClientGunfire.Predict
        ClientGunfire.Predict = function(self, tool, origin, dir)
            local hits, insts = ClientGunfire._OrigPredict(self, tool, origin, dir)
            if Hub.Running and Hub.DogHitboxEnabled and type(hits) == "table" and type(insts) == "table" then
                local npcs = workspace:FindFirstChild("NPCs")
                if npcs then
                    for i, inst in pairs(insts) do
                        if typeof(inst) == "Instance" and inst:IsDescendantOf(npcs) then
                            local dogModel = inst:FindFirstAncestorOfClass("Model")
                            local realTorso = dogModel and (dogModel:FindFirstChild("Torso") or dogModel:FindFirstChild("HumanoidRootPart"))
                            if realTorso and realTorso:IsA("BasePart") then
                                insts[i] = realTorso
                                hits[i] = realTorso.Position
                            end
                        end
                    end
                end
            end
            return hits, insts
        end
    end

    if ClientGun and type(rawget(ClientGun, "_fire")) == "function" then
        ClientGun._OrigFire = ClientGun._OrigFire or ClientGun._fire
        ClientGun._fire = function(self, tool, aimPos)
            if Hub.Running and Hub.AutoAimGuns and tool and tool:IsA("Tool") then
                if tool:GetAttribute("Spread") ~= 0 then
                    pcall(function() tool:SetAttribute("Spread", 0) end)
                end
                local charData = GetCharacterData()
                if charData and not charData.Disabled then
                    local originPos = GetGunOriginPos(tool, charData)
                    local gunRange = GetGunRange(tool)
                    local _, aimPart = SelectTargetDogToShoot(originPos, gunRange)
                    if aimPart then
                        aimPos = ComputePredictedAimPos(tool, originPos, aimPart)
                    end
                end
            end
            return ClientGun._OrigFire(self, tool, aimPos)
        end
    end
end

