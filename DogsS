local function ProbeSingleRay(originPos, dir, maxDist)
    local footY = originPos.Y - 2.95
    local ankleHit = workspace:Raycast(originPos - Vector3.new(0, 2.35, 0), dir * maxDist, MapRayParams)
    local kneeHit = workspace:Raycast(originPos - Vector3.new(0, 1.2, 0), dir * maxDist, MapRayParams)
    local chestHit = workspace:Raycast(originPos + Vector3.new(0, 0.4, 0), dir * maxDist, MapRayParams)

    local firstHit = ankleHit
    if kneeHit and (not firstHit or kneeHit.Distance < firstHit.Distance) then
        firstHit = kneeHit
    end
    if chestHit and (not firstHit or chestHit.Distance < firstHit.Distance) then
        firstHit = chestHit
    end

    if not firstHit then
        return "open", maxDist, 0
    end

    if firstHit.Normal.Y >= 0.55 then
        local upHit = workspace:Raycast(originPos + dir * math.min(firstHit.Distance + 2.5, maxDist) + Vector3.new(0, 3.0, 0), dir * math.max(maxDist - firstHit.Distance, 4.0), MapRayParams)
        if upHit and upHit.Normal.Y < 0.55 then
            return "wall", firstHit.Distance + upHit.Distance, 99
        end
        return "open", maxDist, 2.5
    end

    local hitDist = firstHit.Distance
    local probePoint = originPos + dir * (hitDist + 1.15)
    local headClear = not workspace:Raycast(originPos + Vector3.new(0, 4.8, 0), dir * (hitDist + 1.4), MapRayParams)

    if headClear then
        local downHit = workspace:Raycast(probePoint + Vector3.new(0, 5.8, 0), Vector3.new(0, -9.8, 0), MapRayParams)
        if downHit then
            local stepHeight = downHit.Position.Y - footY
            if stepHeight > 0.25 and stepHeight <= 6.4 then
                return "step", hitDist, stepHeight
            end
        end
    end

    return "wall", hitDist, 99
end

local function ProbeDirectionWide(myPos, dir, maxDist)
    local right = Vector3.new(-dir.Z, 0, dir.X)
    local cKind, cDist, cStep = ProbeSingleRay(myPos, dir, maxDist)
    local lKind, lDist = ProbeSingleRay(myPos - right * 0.85, dir, math.min(maxDist, 7))
    local rKind, rDist = ProbeSingleRay(myPos + right * 0.85, dir, math.min(maxDist, 7))

    if (lKind == "wall" and lDist < 1.8) or (rKind == "wall" and rDist < 1.8) then
        return "wall", math.min(cDist, lDist, rDist), 99
    end

    local minClear = math.min(cDist, (lKind == "wall" and lDist or maxDist), (rKind == "wall" and rDist or maxDist))
    if cKind == "step" or (lKind == "step" and lDist <= 3.2) or (rKind == "step" and rDist <= 3.2) then
        return "step", math.min(cDist, lDist, rDist), cStep
    end

    return cKind, minClear, cStep
end

local function GetCornerExitOpenness(samplePos, dir)
    local right = Vector3.new(-dir.Z, 0, dir.X)
    local probeOrigin = samplePos + Vector3.new(0, 1.5, 0)
    local fHit = workspace:Raycast(probeOrigin, dir * 9.0, MapRayParams)
    local lHit = workspace:Raycast(probeOrigin, -right * 8.0, MapRayParams)
    local rHit = workspace:Raycast(probeOrigin, right * 8.0, MapRayParams)

    local fClear = (not fHit or fHit.Normal.Y >= 0.55) and 9.0 or fHit.Distance
    local lClear = (not lHit or lHit.Normal.Y >= 0.55) and 8.0 or lHit.Distance
    local rClear = (not rHit or rHit.Normal.Y >= 0.55) and 8.0 or rHit.Distance
    return fClear + math.max(lClear, rClear)
end

local BypassVector = nil
local BypassUntil = 0

local function SteerAndClimbTowards(charData, rawGoal, threats, isEvading, dogSpawns, ragdollPads, candyPos)
    UpdateRayFilter()
    local root = charData.Root
    local myPos = root.Position
    local flatDelta = Vector3.new(rawGoal.X - myPos.X, 0, rawGoal.Z - myPos.Z)
    if flatDelta.Magnitude < 0.25 and not isEvading then
        if (rawGoal.Y - myPos.Y) > 1.4 then
            TriggerSmartJump(charData)
        end
        return rawGoal
    end

    local desiredDir = flatDelta.Magnitude > 0.05 and flatDelta.Unit or root.CFrame.LookVector
    local candyDir = nil
    if candyPos then
        local cd = Vector3.new(candyPos.X - myPos.X, 0, candyPos.Z - myPos.Z)
        if cd.Magnitude > 0.1 then
            candyDir = cd.Unit
        end
    end

    local climbDesired = (rawGoal.Y - myPos.Y) > 1.3 or (candyPos ~= nil and (candyPos.Y - myPos.Y) > 1.5)
    if climbDesired and flatDelta.Magnitude <= 9.5 then
        TriggerSmartJump(charData)
    end

    local nearestDogD = GetThreatMetrics(myPos, threats)
    local dogsClose = Hub.AvoidDogs and (isEvading or nearestDogD <= 17.5)

    if not dogsClose and os.clock() >= BypassUntil then
        local checkLen = math.clamp(flatDelta.Magnitude, 4.5, 9.5)
        local directKind, directDist = ProbeDirectionWide(myPos, desiredDir, checkLen)
        if directKind == "step" and directDist <= 3.8 then
            TriggerSmartJump(charData)
            BypassVector = nil
            return myPos + desiredDir * 10
        elseif directKind == "open" and directDist >= checkLen - 0.3 then
            return rawGoal
        end
    end

    if not dogsClose and BypassVector and os.clock() < BypassUntil then
        local bKind, bDist = ProbeDirectionWide(myPos, BypassVector, 6.0)
        if bKind == "step" and bDist <= 3.8 then
            TriggerSmartJump(charData)
            return myPos + BypassVector * 10
        elseif bKind == "open" and bDist >= 5.2 then
            return myPos + BypassVector * 10
        end
    end

    local bestDir = desiredDir
    local bestScore = -math.huge
    local bestJump = false

    for i = 0, 23 do
        local angle = (i / 24) * math.pi * 2
        local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
        local kind, dist, stepLift = ProbeDirectionWide(myPos, dir, 24)

        if kind == "open" or kind == "step" or dist >= 5.5 then
            local reach = (kind == "step") and 14 or dist
            local moveStep = math.min(reach, 11)
            local samplePos = myPos + dir * moveStep

            local alignDesired = dir:Dot(desiredDir)
            local alignCandy = candyDir and dir:Dot(candyDir) or alignDesired
            local alignCurrent = BypassVector and (dir:Dot(BypassVector) * 4.5) or 0
            local hazardPenalty = GetStuckAndHazardPenalty(samplePos, dogSpawns, ragdollPads)
            local exitOpenness = GetCornerExitOpenness(samplePos, dir)

            local stepScore = 0
            if kind == "step" then
                stepScore = (climbDesired or isEvading) and 24 or 10
            elseif kind == "open" and stepLift and stepLift > 0.5 then
                stepScore = (climbDesired or isEvading) and 18 or 6
            elseif kind == "wall" then
                if dist < 8.5 then
                    stepScore = -160 - (8.5 - dist) * 20
                else
                    stepScore = -45
                end
            end

            if exitOpenness < 8.5 then
                stepScore -= (8.5 - exitOpenness) * 18
            else
                stepScore += math.min(exitOpenness, 16) * 1.4
            end

            local dogScore = 0
            if threats and #threats > 0 then
                local minDogD = math.huge
                local minSegD = math.huge
                for _, t in ipairs(threats) do
                    local d = math.min((samplePos - t.Pos).Magnitude, (samplePos - t.PredPos).Magnitude)
                    if d < minDogD then minDogD = d end
                    local segD = math.min(
                        PointToSegmentDistance(t.Pos, myPos, samplePos),
                        PointToSegmentDistance(t.PredPos, myPos, samplePos)
                    )
                    if segD < minSegD then minSegD = segD end

                    local toDog = Vector3.new(t.Pos.X - myPos.X, 0, t.Pos.Z - myPos.Z)
                    local dogDistNow = toDog.Magnitude
                    if dogDistNow > 0.1 and dogDistNow < 24 then
                        local dogAlign = dir:Dot(toDog.Unit)
                        if dogAlign > 0.15 then
                            dogScore -= dogAlign * (isEvading and 85 or 52)
                        end
                    end
                end

                if minSegD < 6.5 then
                    dogScore -= (6.5 - minSegD) * 45
                end
                dogScore += math.min(minDogD, 32) * (isEvading and 3.4 or 1.3)
            end

            local goalScore
            if isEvading then
                goalScore = (alignDesired * 10) + (alignCandy * 20)
            else
                goalScore = (alignDesired * 26) + (alignCandy * 8)
            end

            local score = goalScore + (math.min(reach, 22) * 1.6) + stepScore + dogScore + alignCurrent - hazardPenalty
            if score > bestScore then
                bestScore = score
                bestDir = dir
                bestJump = (kind == "step" and dist <= 3.8)
            end
        end
    end

    BypassVector = bestDir
    BypassUntil = os.clock() + (isEvading and 0.25 or 0.55)

    if bestJump then
        TriggerSmartJump(charData)
    end

    return myPos + bestDir * 12
end

local WalkerThread = task.spawn(function()
    local waypoints = nil
    local wpIndex = 1
    local lastPathTime = 0
    local lastTargetPart = nil
    local targetLockStart = 0
    local targetStartDist = math.huge
    local lastCheckPos = Vector3.zero
    local lastCheckTime = os.clock()
    local stuckCount = 0

    local function ResetNav()
        waypoints = nil
        wpIndex = 1
        lastPathTime = 0
        lastTargetPart = nil
        targetLockStart = 0
        targetStartDist = math.huge
        stuckCount = 0
        BypassVector = nil
        BypassUntil = 0
    end

    table.insert(Hub.Connections, LocalPlayer.CharacterAdded:Connect(function()
        task.delay(0.4, LocateLiveControllers)
        table.clear(Hub.Blacklist)
        table.clear(Hub.FailCounts)
        table.clear(Hub.StuckZones)
        CachedLobbyBox = nil
        Hub.MoveGoal = nil
        Hub.LockedDog = nil
        Hub.WeEquippedGun = false
        ReleaseMinigunSpin()
        ResetNav()
    end))

    while Hub.Running do
        if not Hub.AutoWalkEnabled then
            Hub.CurrentTarget = nil
            Hub.MoveGoal = nil
            Hub.StatusText = "auto walk off"
            ResetNav()
            task.wait(0.2)
            continue
        end

        if not IsInRound() then
            Hub.CurrentTarget = nil
            Hub.MoveGoal = nil
            Hub.StatusText = "in lobby (waiting for match)"
            ResetNav()
            task.wait(0.3)
            continue
        end

        local charData = GetCharacterData()
        if not charData or charData.Disabled then
            Hub.CurrentTarget = nil
            Hub.MoveGoal = nil
            Hub.StatusText = "waiting for character..."
            ResetNav()
            task.wait(0.2)
            continue
        end

        local myPos = charData.Root.Position
        local onGround = charData.Humanoid.FloorMaterial ~= Enum.Material.Air
        local threats = GetActiveThreats()
        local dogSpawns = GetDogSpawnPositions()
        local ragdollPads = GetRagdollPadPositions()
        local nearestDogDist = GetThreatMetrics(myPos, threats)
        local nearestSpawnDist, nearestSpawnPos = GetNearestDogSpawnDist(myPos, dogSpawns)

        if lastTargetPart and IsBonbonValid(lastTargetPart) and not Hub.Blacklist[lastTargetPart] then
            local curTargetPos = GetTrueBonbonPos(lastTargetPart)
            local curTargetDist = (curTargetPos - myPos).Magnitude
            if curTargetDist < targetStartDist - 2.5 then
                targetStartDist = curTargetDist
                targetLockStart = os.clock()
            elseif os.clock() - targetLockStart > 5.5 then
                Hub.Blacklist[lastTargetPart] = os.clock() + 7.0
                ResetNav()
            end
        end

        local target = ChooseTargetBonbon(myPos, threats, dogSpawns)
        Hub.CurrentTarget = target

        if target ~= lastTargetPart then
            targetLockStart = os.clock()
            targetStartDist = target and (GetTrueBonbonPos(target) - myPos).Magnitude or math.huge
        end

        local targetPos = target and GetTrueBonbonPos(target) or nil
        local floorTargetPos = targetPos and GetFloorPos(targetPos) or nil
        local distToTarget = targetPos and (targetPos - myPos).Magnitude or math.huge

        if os.clock() - lastCheckTime >= 0.3 then
            local moved = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(lastCheckPos.X, 0, lastCheckPos.Z)).Magnitude
            lastCheckPos = myPos
            lastCheckTime = os.clock()

            if moved < 0.85 and onGround and Hub.MoveGoal ~= nil then
                stuckCount += 1
                TriggerSmartJump(charData)

                if stuckCount >= 2 then
                    local forwardLook = charData.Root.CFrame.LookVector
                    local blockedSpot = myPos + Vector3.new(forwardLook.X, 0, forwardLook.Z) * 2.5
                    table.insert(Hub.StuckZones, {
                        Pos = blockedSpot,
                        Radius = 8.0,
                        Expire = os.clock() + 10.0
                    })

                    BypassUntil = 0
                    Hub.MoveGoal = SteerAndClimbTowards(charData, myPos - Vector3.new(forwardLook.X, 0, forwardLook.Z) * 12, threats, true, dogSpawns, ragdollPads, targetPos)
                    if stuckCount >= 4 and target then
                        Hub.Blacklist[target] = os.clock() + 7.0
                    end
                    waypoints = nil
                    stuckCount = 0
                    task.wait(0.25)
                    continue
                end
            elseif moved >= 0.85 then
                stuckCount = 0
            end
        end

        local rushingNearbyCandy = (target ~= nil and CanRushBonbon(myPos, targetPos, threats))

        if Hub.AvoidDogs and nearestDogDist <= Hub.DogEvadeRadius and not rushingNearbyCandy then
            local awayVec = Vector3.zero
            for _, t in ipairs(threats) do
                local dv = Vector3.new(myPos.X - t.Pos.X, 0, myPos.Z - t.Pos.Z)
                local d = math.max(dv.Magnitude, 0.5)
                if d < 28 then
                    awayVec += dv.Unit * ((28 - d) / 28)
                end
            end
            local rawEvadeGoal = awayVec.Magnitude > 0.05 and (myPos + awayVec.Unit * 20) or (targetPos or (myPos + charData.Root.CFrame.LookVector * 16))
            Hub.MoveGoal = SteerAndClimbTowards(charData, rawEvadeGoal, threats, true, dogSpawns, ragdollPads, targetPos)
            waypoints = nil
            Hub.StatusText = string.format("evading dog (%.1fm)", nearestDogDist)
            task.wait(0.06)
            continue
        end

        if not target then
            local totalLeft = #GetUncollectedBonbons()
            if totalLeft > 0 or (Hub.AvoidDogs and (nearestDogDist < 32 or nearestSpawnDist < Hub.DogSpawnAvoidRadius)) then
                local awayVec = Vector3.zero
                for _, t in ipairs(threats) do
                    local dv = Vector3.new(myPos.X - t.Pos.X, 0, myPos.Z - t.Pos.Z)
                    local d = math.max(dv.Magnitude, 1)
                    if d < 45 then
                        awayVec += (dv.Unit * (45 - d))
                    end
                end
                if nearestSpawnPos and nearestSpawnDist < Hub.DogSpawnAvoidRadius + 10 then
                    local sv = Vector3.new(myPos.X - nearestSpawnPos.X, 0, myPos.Z - nearestSpawnPos.Z)
                    if sv.Magnitude > 0.1 then
                        awayVec += sv.Unit * 25
                    end
                end
                local roamGoal = awayVec.Magnitude > 0.1 and (myPos + awayVec.Unit * 18) or (myPos + charData.Root.CFrame.LookVector * 14)
                Hub.MoveGoal = SteerAndClimbTowards(charData, roamGoal, threats, true, dogSpawns, ragdollPads, nil)
                Hub.StatusText = totalLeft > 0
                    and string.format("avoiding dogs (%d left)", totalLeft)
                    or "moving away from dog spawns"
            else
                Hub.MoveGoal = nil
                Hub.StatusText = "all bonbons collected (safe)"
            end
            task.wait(0.12)
            continue
        end

        if (targetPos.Y - myPos.Y) > 1.4 and Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z).Magnitude <= 9.5 then
            TriggerSmartJump(charData)
        end

        if distToTarget <= Hub.StopDistance then
            TriggerTouch(target, charData)
            Hub.MoveGoal = SteerAndClimbTowards(charData, targetPos, threats, false, dogSpawns, ragdollPads, targetPos)
            Hub.StatusText = string.format("collecting (%.1fm)", distToTarget)
            task.wait(0.06)
            continue
        end

        local needPath = (target ~= lastTargetPart)
            or (not waypoints)
            or (wpIndex > #waypoints)
            or (onGround and (os.clock() - lastPathTime >= 1.2))

        if needPath and onGround and os.clock() >= BypassUntil then
            lastTargetPart = target
            lastPathTime = os.clock()

            local path = PathfindingService:CreatePath({
                AgentRadius = 1.35,
                AgentHeight = 4.6,
                AgentCanJump = true,
                AgentCanClimb = true,
                WaypointSpacing = 3.0
            })

            local startFloor = GetFloorPos(myPos)
            local ok = pcall(function()
                path:ComputeAsync(startFloor, floorTargetPos)
            end)

            local rawWps = ok and path:GetWaypoints() or nil
            if rawWps and #rawWps >= 2 then
                Hub.FailCounts[target] = 0
                waypoints = rawWps
                wpIndex = 2
                while wpIndex < #waypoints do
                    local wpPos = waypoints[wpIndex].Position
                    local d3 = (Vector3.new(wpPos.X, myPos.Y, wpPos.Z) - myPos).Magnitude
                    if d3 < 3.4 and math.abs(wpPos.Y - (myPos.Y - 2.5)) <= 4.0 then
                        wpIndex += 1
                    else
                        break
                    end
                end
            else
                waypoints = nil
                local fails = (Hub.FailCounts[target] or 0) + 1
                Hub.FailCounts[target] = fails
                if fails >= 3 and distToTarget > 24 then
                    Hub.Blacklist[target] = os.clock() + 6.0
                    ResetNav()
                    task.wait(0.05)
                    continue
                end
                Hub.MoveGoal = SteerAndClimbTowards(charData, floorTargetPos, threats, false, dogSpawns, ragdollPads, targetPos)
                Hub.StatusText = string.format("direct -> %.1fm", distToTarget)
                task.wait(0.06)
                continue
            end
        end

        if waypoints and wpIndex <= #waypoints and os.clock() >= BypassUntil then
            while wpIndex < #waypoints do
                local wpPos = waypoints[wpIndex].Position
                local flatDist = (Vector3.new(wpPos.X, myPos.Y, wpPos.Z) - myPos).Magnitude
                local yDist = math.abs(wpPos.Y - (myPos.Y - 2.5))
                if flatDist < 3.2 and yDist <= 4.5 then
                    wpIndex += 1
                else
                    break
                end
            end

            local wp = waypoints[wpIndex]
            if wp.Action == Enum.PathWaypointAction.Jump or (wp.Position.Y - (myPos.Y - 2.95)) > 1.5 then
                TriggerSmartJump(charData)
            end

            Hub.MoveGoal = SteerAndClimbTowards(charData, wp.Position, threats, false, dogSpawns, ragdollPads, targetPos)
            Hub.StatusText = string.format("collecting -> %.1fm", distToTarget)
        else
            Hub.MoveGoal = SteerAndClimbTowards(charData, floorTargetPos, threats, false, dogSpawns, ragdollPads, targetPos)
            Hub.StatusText = string.format("direct -> %.1fm", distToTarget)
        end

        task.wait(0.06)
    end
end)

local function BindShopTracker()
